# ============================================================
# cukingPro Web — contoh konfigurasi environment
# Salin ke `.env` lalu isi nilainya. JANGAN commit `.env`.
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/cukingpro"

# --- Better Auth ---
# Buat dengan: openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-secret-acak-minimal-32-byte"
BETTER_AUTH_URL="http://localhost:3000"

# --- Batas paket Free (FR-17) ---
FREE_HISTORY_MONTHS="3"
FREE_MAX_TRACKED_CATS="2"

# --- Email (FR-01, FR-06) ---
# Selama SMTP belum diisi, tautan verifikasi hanya ditulis ke log server (dev).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="cukingPro <no-reply@cukingpro.local>"

# --- Web Push (FR-21) ---
# Buat dengan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@cukingpro.local"

# --- Midtrans (FR-18) ---
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# --- Cron job harian (FR-06, FR-18, FR-20) ---
CRON_SECRET="ganti-dengan-secret-acak"

# --- Mode demo (development) ---
# true = tampilkan pemilih akun demo di halaman login. JANGAN aktifkan di produksi.
DEMO_MODE="true"
